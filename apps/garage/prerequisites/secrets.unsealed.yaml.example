# Copy to secrets.unsealed.yaml, fill in, then run ../create-secrets.bash.
# `*.unsealed.yaml` is gitignored; only the sealed output is committed.
#
#   rpc-secret:   openssl rand -hex 32   (exactly 32 bytes of hex; Garage
#                                         refuses to start on anything else)
#   admin-token:  openssl rand -base64 32
#
# The S3 access key for Pilke is NOT here. Garage mints its own keys, so that
# one does not exist until the bootstrap in README.md has run — and it is sealed
# into `apps/pilke` rather than into this namespace, because that is where it is
# read.
apiVersion: v1
kind: Secret
metadata:
  name: garage-secrets
  namespace: garage
type: Opaque
stringData:
  rpc-secret: ""
  admin-token: ""
