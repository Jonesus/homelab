# Copy to app-secrets.unsealed.yaml, fill in, then run ../create-secrets.bash.
#
#   SECRET_KEY: python -c "import secrets; print(secrets.token_urlsafe(64))"
#
# `settings.py` has no default for SECRET_KEY, so a missing one fails loudly at
# import rather than silently signing with a known value. env.example ships
# `foo`; that must not travel.
apiVersion: v1
kind: Secret
metadata:
  name: pilke-app-secrets
  namespace: pilke
type: Opaque
stringData:
  SECRET_KEY: ""

  # Expo push. Without it notifications are accepted and never delivered.
  EXPO_ACCESS_TOKEN: ""

  # The Garage key, from `garage key create pilke` — see apps/garage/README.md.
  # boto3 reads these from the environment, so they are not in
  # MEDIA_STORAGE_OPTIONS, where they would be a ConfigMap holding a secret.
  AWS_ACCESS_KEY_ID: ""
  AWS_SECRET_ACCESS_KEY: ""

  # GatewayAPI, EU platform. Leave this out entirely until the public Ingress
  # goes live — SMS_BACKEND in the ConfigMap is what actually arms it, and an
  # empty token with that backend selected FAILS every login rather than
  # falling back to echoing the code. That pairing is the safety property.
  GATEWAYAPI_TOKEN: ""

  # What `seed_admin` reads to create the Django admin account. The phone
  # number is a real login identity: with SMS live, this is the number the
  # admin's one-time codes are texted to.
  DJANGO_SUPERUSER_PHONE_NUMBER: ""
  DJANGO_SUPERUSER_PASSWORD: ""
  DJANGO_SUPERUSER_EMAIL: ""
  DJANGO_SUPERUSER_NICKNAME: ""
  DJANGO_SUPERUSER_GENDER: "other"
  DJANGO_SUPERUSER_BIRTHDAY: "1970-01-01"
  DJANGO_SUPERUSER_DATE_LOCATION_PREFERENCE: "POINT(24.94 60.17)"
  DJANGO_SUPERUSER_DATE_LOCATION_PREFERENCE_RADIUS: "5"
